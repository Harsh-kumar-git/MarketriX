// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String
  passwordHash      String?           // Optional for OAuth users
  role              UserRole          @default(team_member)
  subscriptionPlan SubscriptionPlan  @default(free)
  stripeCustomerId  String?
  emailVerified     Boolean           @default(false)
  image             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  clients           Client[]
  accounts          Account[]
  sessions          Session[]
  subscription      Subscription?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id          String        @id @default(cuid())
  name        String
  website     String?
  industry    String?
  logo        String?
  userId      String
  status      ClientStatus  @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts       Post[]
  teamMembers TeamMember[]

  @@map("clients")
}

model SocialAccount {
  id            String        @id @default(cuid())
  platform      SocialPlatform
  handle        String
  accessToken   String
  refreshToken  String?
  clientId      String
  followers     Int           @default(0)
  isConnected   Boolean       @default(true)
  externalId    String?       // Platform-specific user ID
  username      String?       // Platform username
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts         Post[]
  analytics     Analytics[]

  @@unique([platform, clientId])
  @@map("social_accounts")
}

model Post {
  id            String      @id @default(cuid())
  title         String
  content       String?
  platform      SocialPlatform
  status        PostStatus  @default(draft)
  scheduledDate DateTime?
  publishedDate DateTime?
  clientId      String
  socialAccountId String?    // Direct link to specific social account
  mediaUrls     String[]    // Array of media file URLs
  hashtags      String[]    // Array of hashtags
  errorMessage  String?     // Error message if publishing failed
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id])
  mediaFiles    MediaFile[]
  analytics     Analytics[]

  @@map("posts")
}

model MediaFile {
  id       String   @id @default(cuid())
  filename String
  url      String
  size     Int
  type     String   // MIME type
  postId   String?
  key      String?  // Storage key for S3/etc.
  createdAt DateTime @default(now())

  // Relations
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("media_files")
}

model Analytics {
  id          String @id @default(cuid())
  postId      String?
  accountId   String?
  platform    SocialPlatform
  engagement  Int    @default(0)
  impressions Int    @default(0)
  clicks      Int    @default(0)
  likes       Int    @default(0)
  comments    Int    @default(0)
  shares      Int    @default(0)
  date        DateTime @default(now())

  // Relations
  post        Post?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  account     SocialAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("analytics")
}

model TeamMember {
  id          String      @id @default(cuid())
  userId      String
  clientId    String
  role        String      @default("member")
  permissions String[]    // Array of permission strings
  invitedAt   DateTime    @default(now())
  joinedAt    DateTime?
  createdAt   DateTime    @default(now())

  // Relations
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@map("team_members")
}

model Subscription {
  id                   String            @id @default(cuid())
  userId               String            @unique
  plan                 SubscriptionPlan
  status               String            @default("active")
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String?
  stripePriceId        String?
  canceledAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Relations
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model ContentTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // e.g., "Instagram Caption", "LinkedIn Post"
  content     String   // Template content with placeholders
  variables   String[] // Array of variable names for placeholders
  platform    SocialPlatform?
  isPublic    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("content_templates")
}

model ScheduledPost {
  id          String   @id @default(cuid())
  postId      String   @unique
  scheduledAt DateTime
  status      String   @default("pending") // pending, processing, completed, failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  lastAttempt DateTime?
  errorMessage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("scheduled_posts")
}

// Enums
enum UserRole {
  admin
  manager
  team_member
}

enum SubscriptionPlan {
  free
  pro
  business
}

enum SocialPlatform {
  instagram
  facebook
  twitter
  linkedin
  tiktok
  pinterest
  youtube
}

enum PostStatus {
  draft
  scheduled
  published
  failed
}

enum ClientStatus {
  active
  inactive
  pending
}