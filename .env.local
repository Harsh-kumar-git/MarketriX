# Development Environment Variables
# Copy from .env.example and fill in your actual values

# Database (using SQLite for local development)
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_SECRET="development-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers - Replace with your actual credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers - Replace with your actual API keys
OPENAI_API_KEY=""

# Stripe - Replace with your test keys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email Service
SENDGRID_API_KEY=""

# File Storage (using local storage for development)
# AWS credentials can be added later for production

# Redis (optional for local development)
REDIS_URL="redis://localhost:6379"

# Application Settings
NODE_ENV="development"